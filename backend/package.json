{
  "name": "@bmc-ai/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:build": "tsc -p tsconfig.dev.json",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --pool=threads --poolOptions.threads.singleThread=true",
    "compile:discovery": "tsc -p tsconfig.scripts.json",
    "discover:anchor:node": "npm run compile:discovery && node dist-scripts/scripts/anchor-hino-discovery.js",
    "discover:mysql": "npm run compile:discovery && node dist-scripts/scripts/discover-mysql.js",
    "discover:sqlserver": "npm run compile:discovery && node dist-scripts/scripts/discover-sqlserver.js",
    "discover:production": "npm run compile:discovery && node dist-scripts/scripts/discover-production.js",
    "discover:sales": "npm run compile:discovery && node dist-scripts/scripts/discover-sales-sources.js",
    "inspect:sales": "npm run compile:discovery && node dist-scripts/scripts/inspect-active-sales.js",
    "validate:links": "npm run compile:discovery && node dist-scripts/scripts/validate-business-links.js",
    "discover:anchor": "npm run compile:discovery && node dist-scripts/scripts/anchor-hino-discovery.js",
    "inspect:downstream": "npm run compile:discovery && node dist-scripts/scripts/inspect-downstream-semantics.js",
    "validate:fg": "npm run compile:discovery && node dist-scripts/scripts/validate-fg-transactions.js",
    "validate:delivery-grouping": "npm run compile:discovery && node dist-scripts/scripts/validate-delivery-grouping.js",
    "classify:fg": "npm run compile:discovery && node dist-scripts/scripts/classify-fg-events.js",
    "load:test:sql": "npm run compile:discovery && node dist-scripts/scripts/load-test-sql.js",
    "load:test": "npm run compile:discovery && node dist-scripts/scripts/load-test.js",
    "validate:sales": "npm run compile:discovery && node dist-scripts/scripts/validate-sales.js",
    "discover:semantic": "npm run compile:discovery && node dist-scripts/scripts/discover-semantic-catalog.js",
    "semantic:enrich": "npm run compile:discovery && node dist-scripts/scripts/enrich-semantic-catalog.js && npm run semantic:promote-pr-temp",
    "semantic:profile": "npm run compile:discovery && node dist-scripts/scripts/profile-semantic-catalog.js",
    "semantic:validate": "npm run compile:discovery && node dist-scripts/scripts/validate-semantic-relationships.js",
    "semantic:investigate-pr": "npm run compile:discovery && node dist-scripts/scripts/investigate-pr.js",
    "semantic:investigate-pr-sources": "npm run compile:discovery && node dist-scripts/scripts/investigate-pr-sources.js",
    "semantic:evidence": "npm run compile:discovery && node dist-scripts/scripts/extract-pr-evidence.js",
    "semantic:promote-pr-temp": "tsx scripts/promote-pr-temp-data.ts",
    "semantic:investigate-mrp": "tsx scripts/investigate-mrp.ts",
    "semantic:mrp-evidence": "tsx scripts/diagnose-mrp-evidence.ts",
    "semantic:investigate-mrp-active": "tsx scripts/investigate-mrp-active.ts",
    "semantic:profile-purch-mrp": "tsx scripts/profile-purch-mrp.ts",
    "semantic:investigate-purch-mrp-qty": "tsx scripts/investigate-purch-mrp-qty.ts",
    "semantic:investigate-mrp-pr-grain": "tsx scripts/investigate-mrp-pr-grain.ts",
    "semantic:investigate-mrp-pr-deep": "tsx scripts/investigate-mrp-pr-deep.ts",
    "semantic:investigate-final-pr-coverage": "tsx scripts/investigate-final-pr-coverage.ts",
    "semantic:investigate-write-lineage": "tsx scripts/investigate-write-lineage.ts",
    "semantic:validate-final-pr-coverage": "tsx scripts/validate-final-pr-coverage.ts",
    "semantic:validate-pr-creation-status": "tsx scripts/validate-pr-creation-status.ts",
    "semantic:test-pr-creation-status": "tsx scripts/run-pr-creation-status-check.ts",
    "semantic:trace-mrp-pr-lineage": "tsx scripts/trace-mrp-pr-lineage.ts",
    "semantic:investigate-mrp-date-number": "tsx scripts/investigate-mrp-date-number.ts",
    "semantic:profile-mrp-date-format": "tsx scripts/profile-mrp-date-format.ts",
    "semantic:review": "npm run compile:discovery && node dist-scripts/scripts/semantic-review.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "mssql": "^11.0.1",
    "mysql2": "^3.12.0",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
